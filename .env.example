# ==============================================================================
# reconnAIssance — Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file with sensitive API keys!
# ==============================================================================

# LLM Provider Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_SMALL_MODEL=claude-3-5-haiku-20241022

# Backend Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (SQLite default for hackathon, or PostgreSQL)
DATABASE_URL=sqlite:///./reconnAIssance.db

# Frontend Settings (Vite)
VITE_API_BASE_URL=http://localhost:8000
