# Google Gemini API Key (optional - system auto-falls back to MockLLMClient if not set)
GEMINI_API_KEY=

# Database Connection (defaults to local SQLite file)
DATABASE_URL=sqlite:///./reconnaissance.db

# LLM Mode: "auto" (uses live Gemini if key present, else mock), "live", or "mock"
LLM_MODE=auto

# Gemini Model ID (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
