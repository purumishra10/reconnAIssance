# Required for live Settlement Q&A. Leave empty to use offline mock templates.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Database Connection (defaults to local SQLite file)
DATABASE_URL=sqlite:///./reconnaissance.db

# LLM Mode for Q&A: "auto" (uses live Gemini if key present, else mock), "live", or "mock"
LLM_MODE=auto

# Tier-3 matching: "mock" is local and fast. "live" calls Gemini on remaining unmatched pairs.
LLM_MATCH_MODE=mock

# Gemini Model ID
GEMINI_MODEL=gemini-3.6-flash
